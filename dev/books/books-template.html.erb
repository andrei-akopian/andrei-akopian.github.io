<!DOCTYPE html>
<html>
    <head>
        <title>Books</title>
        <style>
            html {
                scrollbar-color: hsl(30, 30%, 50%) hsl(30, 50%, 80%);
            }

            #title-sign {
                position: absolute;
            }
            #chains {
                position:absolute;
                display: flex;
                justify-content: space-around;
                width: 100%;
            }
            .chain {
                outline: black dashed thick;
                border-radius: 0.5em;
                background-color: black;
                width: 0.1em;
                height: 3em;
            }
            #page-title {
                margin: 1em 0em 0em 0.5em;
                padding: 0.5em;
                background-color: chocolate;
                border: solid sienna;
                border-width: 0.5rem 0rem 0.5rem;
                transform: rotate(-8deg);
            }
            body {
                margin: 0;
                height: 100vh;
                background-color: hsl(30, 50%, 70%);
                background-image: repeating-linear-gradient(
                    90deg,
                    hsl(30, 50%, 50%) 0px,
                    hsl(30, 50%, 50%) 10px,
                    transparent 10px,
                    transparent 200px
                )
                ,repeating-linear-gradient(
                    90deg,
                    transparent 0px,
                    transparent 100px,
                    hsl(30, 50%, 50%) 100px,
                    hsl(30, 50%, 50%) 110px,
                    transparent 110px,
                    transparent 400px
                )
                ,repeating-linear-gradient(
                    0deg,
                    hsl(30, 50%, 50%) 0px,
                    hsl(30, 50%, 50%) 5px,
                    transparent 5px,
                    transparent 100px
                );
            }
            h4 {
                margin: 1em auto 0;
            }
            #book-stack {
                width: 100%;
                height: 100%;
                margin: 0em auto 0em;
                display: flex;
                align-items: flex-end;
                overflow: hidden;
                justify-content: space-around;
            }
            #books {
                width: fit-content;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                align-items: center;
            }
            #more-books {
                display: flex;
                flex-direction: column;
                margin: auto;
                width: fit-content;
                align-items: center;
            }
            .background-books {
                z-index: -1;
                position: absolute;
                top: 0;
                width: 100%;
                height: 100%;
                background: repeating-linear-gradient(
                    90deg,
                    transparent 0px,
                    transparent 10px,
                    hsl(60, 70%, 20%) 10px,
                    hsl(60, 70%, 20%) 15px,
                    hsl(60, 70%, 30%) 15px,
                    hsl(60, 70%, 30%) 25px,
                    hsl(60, 70%, 20%) 25px,
                    hsl(60, 70%, 20%) 30px,
                    transparent 30px,
                    transparent 100px
                ),repeating-linear-gradient(
                    90deg,
                    transparent 0px,
                    transparent 30px,
                    hsl(40, 70%, 20%) 30px,
                    hsl(40, 70%, 20%) 35px,
                    hsl(40, 70%, 30%) 35px,
                    hsl(40, 70%, 30%) 45px,
                    hsl(40, 70%, 20%) 45px,
                    hsl(40, 70%, 20%) 50px,
                    transparent 50px,
                    transparent 100px
                ),
                repeating-linear-gradient(
                    90deg,
                    transparent 0px,
                    transparent 50px,
                    hsl(240, 50%, 50%) 50px,
                    hsl(240, 50%, 50%) 55px,
                    hsl(240, 50%, 60%) 55px,
                    hsl(240, 50%, 60%) 65px,
                    hsl(240, 50%, 50%) 65px,
                    hsl(240, 50%, 50%) 70px,
                    transparent 70px,
                    transparent 100px
                );
                mask-image: repeating-linear-gradient(
                    0deg,
                    transparent 0px,
                    transparent 5px,
                    black 5px,
                    black 95px,
                    transparent 95px,
                    transparent 100px
                );
            }
            .book {
                padding: 1em 2em 0em;
                height: 2em;
                min-width: 10em;
                background-image: linear-gradient(0deg, chocolate, #e99b63 50%, chocolate 100%);
                text-align: center;
                border: 0.1em black solid;
            }
            .spine a {
                text-decoration: none;
                color: black;
                font-family: Times New Roman;
            }
            .book:hover {
                height: calc(100vh - 28em);
                background-color: darkorange;
                padding: 0;
            }
            .book:hover .cover {
                display: flex !important;
            }
            .book:hover .spine {
                display: none;
            }
            .cover {
                display: none;
                flex-direction: row;
                height: 100%;
            }
            .cover-text {
                flex-direction: column;
                height: 100%;
                flex-grow: 2;
                --cover-text-max-width: 18em;
            }
            .description {
                width: var(--cover-text-max-width);
                font-family: Bradley Hand, "Brush Script MT", cursive, serif;
            }
            .cover-fold {
                background-color: chocolate;
                width: 0.5em;
                margin-left: 0.5em;
                height: 100%;
            }
            .link-list {
                width: var(--cover-text-max-width);
            }
        </style>
    </head>
    <body>
        <div class="background-books">
        </div>
        <div id="title-sign">
            <div id="chains">
                <div class="chain"></div>
                <div class="chain"></div>
            </div>
            <h1 id="page-title">A Stack of Good Books</h1>
        </div>
        <div id="book-stack">
            <div id="books"><% good_books.each do |book| %><%= book %><% end %></div>
        </div>
        <div id="more-books"><% more_books.each do |book| %><%= book %><% end %></div>
    </body>
</html>
